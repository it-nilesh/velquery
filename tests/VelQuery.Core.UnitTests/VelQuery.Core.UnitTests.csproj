<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>VelQuery.Core.UnitTests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <!-- `dotnet test <project>` runs through VSTest (xunit.runner.visualstudio); the .NET 10 SDK rejects MTP under VSTest. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/VelQuery.Core/VelQuery.Core.csproj" />
  </ItemGroup>
</Project>
