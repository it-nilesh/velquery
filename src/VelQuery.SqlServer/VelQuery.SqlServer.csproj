<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VelQuery.SqlServer</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>SQL Server provider for VelQuery, built on Microsoft.Data.SqlClient.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VelQuery.Core/VelQuery.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <None Include="buildTransitive/VelQuery.SqlServer.props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
</Project>
