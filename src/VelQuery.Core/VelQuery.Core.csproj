<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VelQuery</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>VelQuery execution engine: sessions, typed execution, streaming, transactions and lifecycle safety.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VelQuery.Abstractions/VelQuery.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VelQuery.Core.UnitTests" />
  </ItemGroup>
  <!--
    The generator and analyzers ship inside this package (analyzers/dotnet/cs) so package consumers get them
    automatically. They are not run on Core itself; the project references only order the build. Projects that
    reference Core via ProjectReference add VelQuery.Generators/VelQuery.Analyzers with
    OutputItemType="Analyzer" ReferenceOutputAssembly="false".
  -->
  <ItemGroup>
    <ProjectReference Include="../VelQuery.Generators/VelQuery.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../VelQuery.Analyzers/VelQuery.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../VelQuery.Generators/bin/$(Configuration)/netstandard2.0/VelQuery.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../VelQuery.Analyzers/bin/$(Configuration)/netstandard2.0/VelQuery.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="buildTransitive/VelQuery.Core.props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
</Project>
