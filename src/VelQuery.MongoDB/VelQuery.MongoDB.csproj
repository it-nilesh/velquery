<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VelQuery.MongoDB</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>MongoDB adapter for VelQuery (phase 3 pilot, ADR-0017): typed find/aggregate/write contracts checked at build time, generated reflection-free BSON serializers, explicit session and transaction ownership. Built on the official MongoDB.Driver; does not depend on VelQuery.Core.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VelQuery.Abstractions/VelQuery.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
