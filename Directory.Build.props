<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Authors>VelQuery contributors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Version>0.1.0-alpha</Version>
    <!-- Also required for IDE0005 (unused usings) to run during build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package metadata for every packable library under src/. -->
  <PropertyGroup>
    <PackageTags>sql;database;query;dapper-alternative;source-generator;aot;sqlserver;postgresql;mysql;sqlite;mongodb</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Reproducible paths in CI builds (GitHub Actions sets GITHUB_ACTIONS=true). -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <!-- In-repo consumers reference projects, not packages, so make the dialect property compiler-visible here too. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="VelQuerySqlDialect" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <PropertyGroup Condition="'$(MSBuildProjectDirectory.Contains(`/tests/`))' == 'true' Or '$(MSBuildProjectDirectory.Contains(`/benchmarks/`))' == 'true' Or '$(MSBuildProjectDirectory.Contains(`/samples/`))' == 'true'">
    <IsPackable>false</IsPackable>
    <!-- Tests, benchmarks and samples are not library code: no ConfigureAwait or doc-comment requirements. -->
    <NoWarn>$(NoWarn);CA2007;CA1707;CA1515;CA1812;CA1822;CA1861;CA2000;CS1591</NoWarn>
  </PropertyGroup>
</Project>
