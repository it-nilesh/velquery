<Project>
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Runtime">
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Transitive via Microsoft.Data.SqlClient; pinned to the patched release for CVE-2026-84008
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Remove once SqlClient references >= 9.0.21 itself. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="MongoDB.Driver" Version="3.12.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Compiler">
    <!-- Deliberately not the latest: generators/analyzers must not require a newer compiler than consumers use.
         4.14 loads in VS 17.14 and every .NET 9/10 SDK. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MariaDb" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.16.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Dapper.AOT" Version="1.1.0" />
  </ItemGroup>
</Project>
